# ============================================================
# AI-CONTENT-AUTOMATION — .gitignore
# ============================================================

# Environment variables — NEVER commit
.env
.env.local
.env.production

# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyi

# SQLite database (contains credentials/data)
database/*.db
database/*.db-shm
database/*.db-wal

# Generated content (large files)
generated/
!generated/.gitkeep

# Logs
logs/
!logs/.gitkeep

# Credentials and tokens
*.json
!requirements*.json
oauth_tokens/
tokens/

# Thumbnails / renders
*.mp4
*.mp3
*.wav
*.srt
*.ass

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Streamlit
.streamlit/

# Pytest
.pytest_cache/
htmlcov/
.coverage

# Whisper model cache (large)
~/.cache/whisper/

# Misc
*.log
*.tmp
*.bak
