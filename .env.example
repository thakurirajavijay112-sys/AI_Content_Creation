# ============================================================
# AI-CONTENT-AUTOMATION — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# APP SETTINGS
# ----------------------------------------------------------
APP_NAME=AI-CONTENT-AUTOMATION
APP_ENV=development
# development | production
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Kathmandu

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
DATABASE_PATH=./database/ai_content.db

# ----------------------------------------------------------
# AI PROVIDERS
# ----------------------------------------------------------

# Google Gemini API (get free key at https://aistudio.google.com)
# Free tier: 1500 req/day (Flash), 50 req/day (Pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-flash-lite-latest
GEMINI_DAILY_REQUEST_LIMIT=1400

# Ollama (local, free — install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_ENABLED=true

# AI Provider Priority (comma-separated: gemini,ollama)
AI_PROVIDER_PRIORITY=gemini,ollama

# ----------------------------------------------------------
# VOICE / TTS
# ----------------------------------------------------------
# Primary TTS: edge_tts (free, requires internet)
# Fallback TTS: pyttsx3 (free, 100% offline)
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-AriaNeural
TTS_SPEED=1.0
TTS_VOLUME=1.0

# ----------------------------------------------------------
# WHISPER (local transcription — free)
# ----------------------------------------------------------
WHISPER_MODEL=medium
# tiny | base | small | medium | large-v3
WHISPER_DEVICE=cuda
# cuda | cpu
WHISPER_LANGUAGE=en

# ----------------------------------------------------------
# VIDEO / FFMPEG
# ----------------------------------------------------------
# Leave blank to auto-detect. Set if ffmpeg is not in PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# GPU acceleration: auto | nvenc | cpu
VIDEO_ENCODER=auto
VIDEO_CRF=23
VIDEO_PRESET=medium
# ultrafast | superfast | veryfast | faster | fast | medium | slow

# ----------------------------------------------------------
# SCHEDULER
# ----------------------------------------------------------
SCHEDULER_ENABLED=true
# Daily schedule in 24h HH:MM format (Nepal time by default)
SCHEDULE_TIME_1=08:00
SCHEDULE_TIME_2=14:00
SCHEDULE_TIME_3=20:00
DAILY_VIDEO_LIMIT=3
MANUAL_APPROVAL_REQUIRED=false

# ----------------------------------------------------------
# PUBLISHING — YOUTUBE
# ----------------------------------------------------------
# Get credentials at https://console.cloud.google.com
# YouTube Data API v3 quota: 10,000 units/day (free)
# Each upload costs ~1,600 units
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_ENABLED=false

# ----------------------------------------------------------
# PUBLISHING — META (Instagram + Facebook)
# ----------------------------------------------------------
# Requires Meta Developer App + Professional Account/Page
# Meta app review required before public publishing
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_ENABLED=false
FACEBOOK_ENABLED=false

# ----------------------------------------------------------
# PUBLISHING — TIKTOK
# ----------------------------------------------------------
# TikTok Content Posting API — requires developer account
# New apps default to private-only until audited by TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ENABLED=false

# ----------------------------------------------------------
# PUBLISHING — SNAPCHAT
# ----------------------------------------------------------
# Status: APPROVAL_REQUIRED (Partner access needed)
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_ENABLED=false

# ----------------------------------------------------------
# PUBLISHING — TWITCH
# ----------------------------------------------------------
# Twitch Developer App — register at dev.twitch.tv
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:8080/twitch/callback
TWITCH_ENABLED=false

# ----------------------------------------------------------
# PUBLISHING — KICK
# ----------------------------------------------------------
# Status: LIMITED — no general publishing API as of 2026
# RTMP livestream only
KICK_STREAM_KEY=your_kick_stream_key
KICK_ENABLED=false

# ----------------------------------------------------------
# STOCK FOOTAGE APIS (Free tiers)
# ----------------------------------------------------------
# Pexels API — https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# Pixabay API — https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key

# ----------------------------------------------------------
# DASHBOARD
# ----------------------------------------------------------
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501
DASHBOARD_SECRET_KEY=change_this_to_a_random_string_in_production

# ----------------------------------------------------------
# CONTENT SETTINGS — ENGINE 1 (AI Shorts)
# ----------------------------------------------------------
SHORTS_DEFAULT_DURATION=45
SHORTS_MAX_DURATION=60
SHORTS_MIN_DURATION=30
SHORTS_CATEGORIES=amazing_facts,motivation,ai_technology,horror_stories,football_facts,cricket_facts

# ----------------------------------------------------------
# CONTENT SETTINGS — ENGINE 2 (Streamer Clipper)
# ----------------------------------------------------------
CLIP_DEFAULT_DURATION=35
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=60
CLIP_MIN_SCORE=50

# ----------------------------------------------------------
# CONTENT SETTINGS — ENGINE 3 (YouTuber Engine)
# ----------------------------------------------------------
YOUTUBER_SHORTS_DURATION=45
YOUTUBER_LONGFORM_MIN_DURATION=300
YOUTUBER_LONGFORM_MAX_DURATION=600
